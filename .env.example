# ============================================================================
# Importadora RYM — Variables de entorno
# Copia este archivo a ".env" y ajusta los valores según el entorno.
# El archivo .env NO se sube al repositorio ni al servidor público.
# ============================================================================

APP_NAME="Importadora RYM"
APP_ENV=local              # local | production
APP_DEBUG=true             # false en producción
APP_URL=http://localhost/importadorarym
APP_TIMEZONE=America/Mexico_City
APP_LOCALE=es_MX

# Cierre de sesión por inactividad (segundos). 0 = desactivado. Por defecto 7200 (2 h).
SESSION_TIMEOUT=7200

# Clave secreta para firmar tokens (captcha, etc.). Generar una única por entorno:
#   php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

# Google Analytics (GA4). Pega tu ID de medición (formato G-XXXXXXXXXX).
# Vacío = desactivado.
GA_MEASUREMENT_ID=

# WhatsApp click-to-chat: número con lada país, solo dígitos (52 = México).
WHATSAPP_NUMERO=525552979776
# Mensaje prellenado del click-to-chat (opcional; vacío = sin mensaje precargado).
WHATSAPP_MENSAJE="Hola, me gustaría recibir información sobre sus productos."

# Tasa de IVA (%) usada en las cotizaciones. Por defecto 16.
IVA_TASA=16

# Libreta de visitas: buzón que recibe copia de cada registro (vacío = sin copia).
VISITAS_COPIA_EMAIL=

# Bolsa de trabajo: buzón de RRHH que recibe las postulaciones (vacío = usa MAIL_LEADS).
RRHH_EMAIL=

# Aspel SAE — valores por defecto para la exportación de pedidos (opcionales).
ERP_CLAVE_VENDEDOR=
# Esquema de impuestos general (numérico). Cada producto puede tener el suyo en su
# ficha; este valor cubre a los que no lo tengan capturado. Si un artículo no tiene
# ni el propio ni este, el pedido NO se puede exportar (SAE lo importaría sin impuestos).
ERP_ESQUEMA_IMPUESTOS=
# Serie de folios de pedidos en SAE (clave = serie + consecutivo, alineado a la derecha con blancos).
ERP_SERIE_PEDIDOS=PA
ERP_LONGITUD_CLAVE=10

# ---- SSL / HTTPS -----------------------------------------------------------
# Mantener en false MIENTRAS el dominio NO tenga certificado SSL.
# En el deploy a producción, una vez instalado el SSL, cambiar a true:
#   - redirige automáticamente http -> https (301)
#   - activa la cabecera de seguridad HSTS
FORCE_HTTPS=false

# ── Proxy de confianza ────────────────────────────────────────────────────
# Servidor de Rackspace Cloud Sites (Liquid Web) que hospeda el sitio.
# client_ip() acepta X-Forwarded-For SOLO cuando REMOTE_ADDR coincide con esta
# IP, resuelve la IP real del cliente y el rate-limit deja de ser GLOBAL.
# Admite IP exacta, CIDR o lista separada por coma. Vacío = nunca confiar en
# X-Forwarded-For (seguro por defecto, pero el rate-limit se vuelve global
# detrás de cualquier proxy). En LOCAL déjalo vacío (no hay proxy delante).
# En PRODUCCIÓN (ver docs/DESPLIEGUE.md §3):
#   TRUSTED_PROXY_CIDR=98.129.229.200
TRUSTED_PROXY_CIDR=

# ---- Base de datos (MariaDB) ----------------------------------------------
# En PRODUCCIÓN NO usar root: crea un usuario dedicado con privilegios solo
# sobre la base `importadorarym`:
#   CREATE USER 'rym_app'@'localhost' IDENTIFIED BY 'contraseña-fuerte';
#   GRANT SELECT, INSERT, UPDATE, DELETE ON importadorarym.* TO 'rym_app'@'localhost';
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=importadorarym
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ---- Correo -----------------------------------------------------------------
# MAIL_MAILER: smtp (producción) | mail (sendmail nativo) | log (no envía: escribe
# el correo en storage/logs/mail.log; útil en local sin SMTP).
# Para el SMTP del hosting usa los datos que te dé el panel de Rackspace Cloud Sites
# (Liquid Web) — NO es cPanel, ver docs/DESPLIEGUE.md §0.0 — para la cuenta de correo:
#   MAIL_HOST=mail.importadorarym.com
#   MAIL_PORT=465 y MAIL_ENCRYPTION=ssl   (o 587 con tls)
#   MAIL_USERNAME=no-responder@importadorarym.com  (una cuenta real del dominio)
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-responder@importadorarym.com
MAIL_FROM_NAME="Importadora RYM"
MAIL_REPLY_TO=cotizaciones@importadorarym.com
# Buzón interno que recibe los avisos de leads y pedidos.
MAIL_LEADS=cotizaciones@importadorarym.com

# ============================================================================
# Ejemplo de valores en PRODUCCIÓN:
#   APP_ENV=production
#   APP_DEBUG=false
#   APP_URL=https://www.importadorarym.com   (URL real; alimenta canonical y og)
#   APP_KEY=<generar con el comando de arriba>
#   FORCE_HTTPS=true                          (tras instalar el certificado SSL)
#   DB_USERNAME=rym_app                       (usuario dedicado, no root)
#   MAIL_MAILER=smtp + credenciales del hosting
# ============================================================================
