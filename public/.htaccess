# Front Controller — todo pasa por index.php
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Canonicalización: si el navegador pidió .../public/algo, redirigir a
    # .../algo. En el montaje local, el .htaccess de la raíz ya sirve esta
    # carpeta sin que "/public" aparezca en la URL; esta regla evita que la
    # versión con /public siga funcionando en paralelo (dos URLs por página).
    #
    # Va aquí y no en el .htaccess de la raíz porque Apache NO hereda las reglas
    # de rewrite del directorio padre cuando el subdirectorio define las suyas.
    #
    # La condición mira THE_REQUEST (la petición literal del navegador), que las
    # reescrituras internas no modifican: por eso lo que llega reescrito desde la
    # raíz no se redirige y no se forma un bucle. En producción, con el
    # DocumentRoot apuntando aquí, ninguna URL contiene /public/ y la regla
    # nunca se activa.
    RewriteCond %{THE_REQUEST} \s([^?]*)/public/([^\s?]*) [NC]
    RewriteRule ^ %1/%2 [R=301,L]

    # No reescribir archivos o directorios que existan (assets, uploads, etc.)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # El resto de peticiones las maneja el front controller
    RewriteRule ^ index.php [L]
</IfModule>

# Cabeceras de seguridad básicas
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
</IfModule>

# Caché de estáticos. CSS y JS se piden con ?v=<mtime> (ver el helper asset()),
# así que un cambio genera una URL nueva y la caché larga no retrasa los despliegues.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType text/javascript "access plus 7 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/x-icon "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    # Las fuentes son inmutables: al cambiar de versión cambia el nombre del archivo.
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.woff2$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# Compresión
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml
</IfModule>

# Tipos MIME para la PWA y las fuentes autoalojadas
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
    AddType font/woff2 .woff2
</IfModule>

# El Service Worker: controla todo el scope y no se cachea en el navegador
<IfModule mod_headers.c>
    <FilesMatch "sw\.js$">
        Header set Service-Worker-Allowed "/"
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>

# Evitar listado de directorios
Options -Indexes
