# ============================================================================
# Raíz del proyecto. Interviene siempre que el DocumentRoot NO apunte a /public
# — el caso de XAMPP local Y TAMBIÉN el de producción real (Rackspace Cloud
# Sites no permite fijar el DocumentRoot en una subcarpeta: sube el proyecto
# completo a la raíz del hosting). Hace dos cosas:
#
#   1. Sirve el sitio desde /public sin que "/public" aparezca en la URL.
#   2. Protege el backend, que en este montaje queda bajo la raíz web —
#      TODA esta protección depende de que el hosting respete AllowOverride
#      All (ver docs/ROADMAP.md Fase 0.3 y docs/DESPLIEGUE.md); si Apache lo
#      ignora, este archivo no se aplica y las carpetas listadas abajo (y
#      cualquier .htaccess dentro de ellas) quedan expuestas por HTTP.
# ============================================================================

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # HTTPS + dominio canónico (www) — solo en el dominio de producción, así
    # que no interviene en local (localhost) ni en otros entornos. Se resuelve
    # aquí, en Apache, y no solo en public/index.php: en Rackspace las
    # peticiones por http:// que llegan a PHP devolvían un 500 vacío en vez de
    # la redirección (los estáticos sí respondían), así que la redirección no
    # debe depender de PHP. La de index.php se queda como respaldo.
    #
    # "Ya es HTTPS" si CUALQUIER indicador lo dice (el SSL puede terminar en el
    # balanceador del hosting): ante la duda no se redirige, para no formar un
    # bucle. Confiar aquí en X-Forwarded-Proto sin validar la IP es inofensivo:
    # quien lo falsifique solo se salta su propia redirección.
    RewriteCond %{HTTP_HOST} ^(www\.)?importadorarym\.com$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteCond %{ENV:HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https [NC]
    RewriteCond %{SERVER_PORT} !=443
    RewriteRule ^ https://www.importadorarym.com%{REQUEST_URI} [R=301,L]

    # Ya en HTTPS pero sin www: un solo dominio canónico (el de APP_URL).
    RewriteCond %{HTTP_HOST} ^importadorarym\.com$ [NC]
    RewriteRule ^ https://www.importadorarym.com%{REQUEST_URI} [R=301,L]

    # Acceso directo a las carpetas del backend: denegado.
    RewriteRule ^(app|config|routes|database|storage|docs|build|tests)(/|$) - [F]

    # (La canonicalización de las URLs con /public vive en public/.htaccess:
    #  Apache NO hereda las reglas de rewrite del directorio padre cuando el
    #  subdirectorio define las suyas, así que una regla puesta aquí nunca se
    #  ejecutaría para las peticiones que resuelven dentro de /public.)

    # Todo lo demás se resuelve dentro de /public mediante reescritura interna:
    # la URL que ve el visitante no cambia. Desde ahí, public/.htaccess sirve los
    # archivos que existan y manda el resto al front controller.
    RewriteCond %{REQUEST_URI} !/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Proteger archivos sensibles
<FilesMatch "^(\.env|composer\.(json|lock))$">
    Require all denied
</FilesMatch>
